    "Higher presets add poses and use more credits. Start with Medium.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher presets add poses and use more credits. Start with Medium."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更高的预设增加姿势，也消耗更多点数。可以先试试中等。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更高的預設增加姿勢，也消耗更多點數。可以先試試中等。"
          }
        }
      }
    },
    "Make it feel just right": {
      "extractionState": "manual",
