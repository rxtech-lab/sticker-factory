    "Switch this on for moods and poses you can change after generation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch this on for moods and poses you can change after generation."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，可在生成完成后切换心情和姿势。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，可在產生完成後切換心情和姿勢。"
          }
        }
      }
    },
    "More poses, more possibilities": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More poses, more possibilities"
