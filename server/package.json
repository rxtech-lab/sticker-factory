{
  "name": "sticker-factory-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tutorial:compile && next dev",
    "build": "bun db:migrate && bun run tutorial:compile && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate",
    "db:migrate:turso": "bun --env-file=.env scripts/migrate-turso-to-neon.ts",
    "db:packs:recount": "bun --env-file=.env scripts/recompute-pack-counters.ts",
    "cleanup:uploads": "bun --env-file=.env scripts/cleanup-stale-uploads.ts",
    "cleanup:retry": "bun --env-file=.env scripts/retry-failed-cleanups.ts",
    "dev:e2e": "bun scripts/prepare-e2e.ts && next dev -p 3105",
    "workflow:inspect": "workflow inspect runs",
    "tutorial:compile": "bun scripts/compile-tutorials.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.106",
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "16.3.2",
    "@rxtech-lab/authjs-rxlab": "1.6.1",
    "@types/mdx": "^2.0.14",
    "@vercel/oidc": "3.2.0",
    "ai": "^7.0.105",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.18.0",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "vercel": "^59.10.0",
    "workflow": "^4.8.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@libsql/client": "^0.17.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
