{
  "name": "sticker-factory-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:push": "bun --env-file=.env x drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:packs:recount": "tsx scripts/recompute-pack-counters.ts",
    "cleanup:uploads": "tsx scripts/cleanup-stale-uploads.ts",
    "cleanup:retry": "tsx scripts/retry-failed-cleanups.ts",
    "dev:e2e": "tsx scripts/prepare-e2e.ts && next dev -p 3105",
    "workflow:inspect": "workflow inspect runs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.62",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@libsql/client": "^0.17.4",
    "@rxtech-lab/authjs-rxlab": "1.6.1",
    "@vercel/oidc": "3.2.0",
    "ai": "^7.0.77",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "workflow": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
