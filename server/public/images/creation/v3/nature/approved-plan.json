{
  "version": 3,
  "kind": "animated",
  "title": "Nature pink mascot",
  "summary": "A reference-backed controllable mascot with 8 looping actions and 3 independent moods.",
  "conceptPrompt": "Animate the supplied pink limbless mascot while preserving its exact silhouette, pink palette, unequal glossy eyes, and editable body/eyes/mouth layers. Nature is guidance only and never replaces a user's requested subject. Use Idle, Greeting Wave, Bounce, Sway, Wiggle, Hop, Partial Turn, and Dance with independent Neutral, Happy, and Surprised moods.",
  "posePreset": "ultra",
  "editableLayers": [
    "body",
    "eyes",
    "mouth"
  ],
  "configuration": {
    "controls": [
      {
        "id": "pose",
        "label": "Pose",
        "type": "choice",
        "defaultValue": "idle",
        "options": [
          {
            "id": "idle",
            "label": "Idle"
          },
          {
            "id": "wave",
            "label": "Greeting Wave"
          },
